{
  "_about": "A typical Command Center session (v3), as the MCP calls an agent sends with the slim tool schema (action, id, record). Every turn ends with a publish that carries worked. evals/cc-contract.mjs replays it against a fresh BAB and checks the answer and the stored state after each step. Placeholders: {{origin}}, {{now}} (an ISO time), {{secret}} (a credential-shaped value built at runtime), {{seq:<id>}} and {{seq-1:<id>}} (the stored seq, read before the step), {{saved:<name>}} (a value an earlier step saved with expect.save). A step with \"http\" { url, body, method } sends a plain HTTP request instead (as the backfill tool posts to a backfill link; expect.status is the HTTP status), with the same expect handling. Checks: [path, op, value], ops eq, len, set, unset, match.",
  "steps": [
    {
      "name": "publish before the person switched it on is a 403 that stores nothing",
      "call": { "action": "publish", "id": "billing-export", "record": { "v": 1, "title": "Billing export", "worked": "Started the billing export" } },
      "expect": { "error": "^Command Center is off for [^.]+\\. Ask them to open {{origin}}/command-center and switch it on, then publish again\\. Nothing was stored\\.$" }
    },
    { "name": "the person switches it on (the page, never the agent)", "switch": "on" },
    {
      "name": "first publish of the turn, with worked and size",
      "call": {
        "action": "publish",
        "id": "billing-export",
        "record": {
          "v": 1,
          "title": "Billing export",
          "area": "Finance tools",
          "key": "KEY-1",
          "tasks": [
            { "id": "map-fields", "text": "Map the export fields", "status": "in_progress" },
            { "id": "write-exporter", "text": "Write the exporter", "status": "pending" },
            { "id": "add-tests", "text": "Add tests", "status": "pending" }
          ],
          "links": [{ "label": "Spec", "url": "https://example.com/spec" }],
          "source": { "machine": "laptop", "session": "session-a" },
          "worked": "Planned the billing export in three steps",
          "size": "small"
        }
      },
      "expect": {
        "answer": { "id": "billing-export", "seq": 1 },
        "answerChecks": [["logged", "set"]],
        "save": { "first": "logged" },
        "state": {
          "billing-export": [
            ["seq", "eq", 1],
            ["title", "eq", "Billing export"],
            ["state", "eq", "active"],
            ["kind", "eq", "project"],
            ["tasks", "len", 3],
            ["tasks.0.startedAt", "set"],
            ["tasks.1.startedAt", "unset"],
            ["links.0.url", "eq", "https://example.com/spec"],
            ["source.session", "eq", "session-a"],
            ["updatedAt", "set"],
            ["worked", "unset"],
            ["size", "unset"]
          ]
        }
      }
    },
    {
      "name": "a retried publish is a no-op with the same log entry",
      "call": {
        "action": "publish",
        "id": "billing-export",
        "record": {
          "v": 1,
          "title": "Billing export",
          "area": "Finance tools",
          "key": "KEY-1",
          "tasks": [
            { "id": "map-fields", "text": "Map the export fields", "status": "in_progress" },
            { "id": "write-exporter", "text": "Write the exporter", "status": "pending" },
            { "id": "add-tests", "text": "Add tests", "status": "pending" }
          ],
          "links": [{ "label": "Spec", "url": "https://example.com/spec" }],
          "source": { "machine": "laptop", "session": "session-a" },
          "worked": "Planned the billing export in three steps",
          "size": "small"
        }
      },
      "expect": { "answer": { "seq": 1, "unchanged": true, "logged": "{{saved:first}}" }, "state": { "billing-export": [["seq", "eq", 1]] } }
    },
    {
      "name": "task status change at wrap-up, with worked",
      "call": {
        "action": "publish",
        "id": "billing-export",
        "record": {
          "v": 1,
          "title": "Billing export",
          "area": "Finance tools",
          "key": "KEY-1",
          "tasks": [
            { "id": "map-fields", "text": "Map the export fields", "status": "done" },
            { "id": "write-exporter", "text": "Write the exporter", "status": "in_progress" },
            { "id": "add-tests", "text": "Add tests", "status": "pending" }
          ],
          "links": [{ "label": "Spec", "url": "https://example.com/spec" }],
          "source": { "machine": "laptop", "session": "session-a" },
          "worked": "Mapped the 8 export fields"
        }
      },
      "expect": {
        "answer": { "seq": 2 },
        "answerChecks": [["logged", "set"]],
        "state": {
          "billing-export": [
            ["seq", "eq", 2],
            ["tasks.0.status", "eq", "done"],
            ["tasks.0.finishedAt", "set"],
            ["tasks.1.status", "eq", "in_progress"],
            ["tasks.1.startedAt", "set"]
          ]
        }
      }
    },
    {
      "name": "the agent stops to ask: the question goes into the record",
      "call": {
        "action": "publish",
        "id": "billing-export",
        "record": {
          "v": 1,
          "title": "Billing export",
          "area": "Finance tools",
          "key": "KEY-1",
          "tasks": [
            { "id": "map-fields", "text": "Map the export fields", "status": "done" },
            { "id": "write-exporter", "text": "Write the exporter", "status": "in_progress" },
            { "id": "add-tests", "text": "Add tests", "status": "pending" }
          ],
          "questions": [{ "id": "date-format", "text": "Which date format should the export use?", "options": ["ISO 8601", "DD/MM/YYYY"] }],
          "links": [{ "label": "Spec", "url": "https://example.com/spec" }],
          "source": { "machine": "laptop", "session": "session-a" },
          "worked": "Asked which date format the export should use"
        }
      },
      "expect": {
        "answer": { "seq": 3, "questions": [{ "id": "date-format" }] },
        "state": {
          "billing-export": [
            ["questions", "len", 1],
            ["questions.0.askedAt", "set"],
            ["questions.0.clearedAt", "unset"],
            ["questions.0.options", "len", 2]
          ]
        }
      }
    },
    {
      "name": "the answer arrives: the next publish leaves the question out, which clears it",
      "call": {
        "action": "publish",
        "id": "billing-export",
        "record": {
          "v": 1,
          "title": "Billing export",
          "area": "Finance tools",
          "key": "KEY-1",
          "tasks": [
            { "id": "map-fields", "text": "Map the export fields", "status": "done" },
            { "id": "write-exporter", "text": "Write the exporter", "status": "done" },
            { "id": "add-tests", "text": "Add tests", "status": "in_progress" }
          ],
          "links": [{ "label": "Spec", "url": "https://example.com/spec" }],
          "source": { "machine": "laptop", "session": "session-a" },
          "worked": "Wrote the exporter with ISO 8601 dates",
          "size": "medium"
        }
      },
      "expect": {
        "answer": { "seq": 4 },
        "state": { "billing-export": [["tasks.1.status", "eq", "done"], ["questions.0.id", "eq", "date-format"], ["questions.0.clearedAt", "set"]] }
      }
    },
    {
      "name": "clear_question is gone for agents and names the fix",
      "call": { "action": "clear_question", "id": "billing-export", "record": { "questionId": "date-format" } },
      "expect": { "error": "^clear_question is gone: publish the record without that question", "state": { "billing-export": [["seq", "eq", 4]] } }
    },
    {
      "name": "comment is gone for agents and names worked",
      "call": { "action": "comment", "id": "billing-export", "record": { "text": "The exporter writes UTF-8." } },
      "expect": { "error": "^comment is gone: publish the record with \"worked\"", "state": { "billing-export": [["seq", "eq", 4]] } }
    },
    {
      "name": "comments in a record are refused and name worked",
      "call": { "action": "publish", "id": "billing-export", "record": { "v": 1, "title": "Billing export", "comments": [{ "id": "n1", "text": "A note" }] } },
      "expect": { "error": "^comments is gone: send \"worked\"", "state": { "billing-export": [["seq", "eq", 4], ["tasks", "len", 3]] } }
    },
    {
      "name": "a secret in worked is refused, names the field and stores nothing",
      "call": {
        "action": "publish",
        "id": "billing-export",
        "record": {
          "v": 1,
          "title": "Billing export",
          "area": "Finance tools",
          "key": "KEY-1",
          "tasks": [
            { "id": "map-fields", "text": "Map the export fields", "status": "done" },
            { "id": "write-exporter", "text": "Write the exporter", "status": "done" },
            { "id": "add-tests", "text": "Add tests", "status": "done" }
          ],
          "source": { "machine": "laptop", "session": "session-a" },
          "worked": "Used the key {{secret}} for the test account"
        }
      },
      "expect": {
        "error": "^worked holds .+, and Command Center never keeps confidential data\\.",
        "state": { "billing-export": [["seq", "eq", 4], ["tasks.2.status", "eq", "in_progress"]] }
      }
    },
    {
      "name": "worked must be one line",
      "call": { "action": "publish", "id": "billing-export", "record": { "v": 1, "title": "Billing export", "worked": "First line\nsecond line" } },
      "expect": { "error": "^worked must be one line", "state": { "billing-export": [["seq", "eq", 4]] } }
    },
    {
      "name": "size goes with worked only",
      "call": { "action": "publish", "id": "billing-export", "record": { "v": 1, "title": "Billing export", "size": "large" } },
      "expect": { "error": "^size goes with worked", "state": { "billing-export": [["seq", "eq", 4]] } }
    },
    {
      "name": "a recurring upkeep initiative publishes its health as a field",
      "call": {
        "action": "publish",
        "id": "nightly-sync",
        "record": {
          "v": 1,
          "title": "Nightly sync check",
          "kind": "recurring",
          "cadence": "daily",
          "health": { "level": "green", "reason": "Last run finished without errors", "checkedAt": "{{now}}" },
          "worked": "Checked the nightly sync"
        }
      },
      "expect": {
        "answer": { "seq": 1 },
        "state": { "nightly-sync": [["kind", "eq", "recurring"], ["cadence", "eq", "daily"], ["health.level", "eq", "green"], ["health.checkedAt", "eq", "{{now}}"], ["health.receivedAt", "set"]] }
      }
    },
    {
      "name": "health is gone as an action and names the field",
      "call": { "action": "health", "id": "nightly-sync", "record": { "level": "red", "reason": "Failed", "checkedAt": "{{now}}" } },
      "expect": { "error": "^health is gone as an action: publish the recurring record with its \"health\" field", "state": { "nightly-sync": [["health.level", "eq", "green"]] } }
    },
    {
      "name": "a turn that changed nothing still logs worked: unchanged, logged, health kept",
      "call": { "action": "publish", "id": "nightly-sync", "record": { "v": 1, "title": "Nightly sync check", "kind": "recurring", "cadence": "daily", "worked": "Answered when the sync last ran" } },
      "expect": {
        "answer": { "seq": 1, "unchanged": true },
        "answerChecks": [["logged", "set"]],
        "state": { "nightly-sync": [["seq", "eq", 1], ["health.level", "eq", "green"]] }
      }
    },
    {
      "name": "list shows both, with seq and the data-health summary",
      "call": { "action": "list" },
      "expect": {
        "answer": { "initiatives": [{ "id": "billing-export", "seq": 4, "openQuestions": 0 }, { "id": "nightly-sync", "seq": 1 }] },
        "answerChecks": [["initiatives", "len", 2], ["dataHealth", "set"]]
      }
    },
    {
      "name": "list with an id returns the full record",
      "call": { "action": "list", "id": "billing-export" },
      "expect": { "answer": { "id": "billing-export", "seq": 4 }, "answerChecks": [["tasks", "len", 3], ["questions.0.clearedAt", "set"]] }
    },
    {
      "name": "a stale expectSeq from a second session is a 409 and changes nothing",
      "as": "second",
      "call": {
        "action": "publish",
        "id": "billing-export",
        "record": {
          "v": 1,
          "title": "Billing export",
          "tasks": [{ "id": "map-fields", "text": "Map the export fields", "status": "done" }],
          "source": { "machine": "vm", "session": "session-b" },
          "expectSeq": "{{seq-1:billing-export}}",
          "worked": "Reviewed the exporter"
        }
      },
      "expect": {
        "error": "^expectSeq is 3 but 'billing-export' is at seq 4\\. Merge your change into the current record",
        "current": [["id", "eq", "billing-export"], ["seq", "eq", 4], ["tasks", "len", 3], ["tasks.2.id", "eq", "add-tests"], ["source.session", "eq", "session-a"]],
        "state": { "billing-export": [["seq", "eq", 4], ["tasks", "len", 3], ["source.session", "eq", "session-a"]] }
      }
    },
    {
      "name": "the merged record with the current expectSeq is accepted",
      "as": "second",
      "call": {
        "action": "publish",
        "id": "billing-export",
        "record": {
          "v": 1,
          "title": "Billing export",
          "area": "Finance tools",
          "key": "KEY-1",
          "tasks": [
            { "id": "map-fields", "text": "Map the export fields", "status": "done" },
            { "id": "write-exporter", "text": "Write the exporter", "status": "done" },
            { "id": "add-tests", "text": "Add tests", "status": "done" }
          ],
          "links": [{ "label": "Spec", "url": "https://example.com/spec" }],
          "source": { "machine": "vm", "session": "session-b" },
          "expectSeq": "{{seq:billing-export}}",
          "worked": "Added the exporter tests, merged with the other session"
        }
      },
      "expect": {
        "answer": { "seq": 5 },
        "answerChecks": [["logged", "set"]],
        "state": { "billing-export": [["seq", "eq", 5], ["tasks.2.status", "eq", "done"], ["source.session", "eq", "session-b"], ["writers", "set"]] }
      }
    },
    {
      "name": "remove takes an initiative off the page",
      "call": { "action": "remove", "id": "nightly-sync" },
      "expect": { "answer": { "removed": true } }
    },
    {
      "name": "list after remove shows one",
      "call": { "action": "list" },
      "expect": { "answer": { "initiatives": [{ "id": "billing-export", "seq": 5 }] }, "answerChecks": [["initiatives", "len", 1]] }
    },
    {
      "name": "backfill_link mints a single-use upload link for the sync",
      "call": { "action": "backfill_link" },
      "expect": {
        "answerChecks": [["url", "match", "^{{origin}}/api/command-center/backfill/[0-9a-f]{64}$"], ["maxCurrent", "eq", 100], ["expiresAt", "set"]],
        "save": { "link1": "url" }
      }
    },
    {
      "name": "an upload of only current creates the open initiative, active with server times",
      "http": {
        "url": "{{saved:link1}}",
        "body": {
          "v": 1,
          "current": [
            {
              "id": "payments-retry",
              "title": "Payments retry",
              "area": "Finance tools",
              "key": "KEY-2",
              "state": "active",
              "tasks": [
                { "id": "find-failures", "text": "Find the failed payments", "status": "done" },
                { "id": "retry-job", "text": "Write the retry job", "status": "in_progress" },
                { "id": "alerting", "text": "Add alerting", "status": "pending" }
              ],
              "questions": [{ "id": "retry-window", "text": "How long should retries go on?", "options": ["24 hours", "7 days"] }],
              "links": []
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "answer": { "accepted": 0, "duplicate": 0, "syncCreated": 1, "syncSkipped": 0 },
        "answerChecks": [["syncRefused", "len", 0], ["refused", "len", 0], ["created", "len", 0]],
        "state": {
          "payments-retry": [
            ["seq", "eq", 1],
            ["title", "eq", "Payments retry"],
            ["state", "eq", "active"],
            ["kind", "eq", "project"],
            ["publishedBy", "eq", "backfill"],
            ["tasks", "len", 3],
            ["tasks.0.finishedAt", "set"],
            ["tasks.1.startedAt", "set"],
            ["tasks.2.startedAt", "unset"],
            ["questions.0.askedAt", "set"],
            ["questions.0.clearedAt", "unset"]
          ]
        }
      }
    },
    {
      "name": "the spent link is a 404 that names the fix",
      "http": { "url": "{{saved:link1}}", "body": { "v": 1, "current": [{ "id": "other-work", "title": "Other work", "state": "active", "tasks": [] }] } },
      "expect": { "status": 404, "error": "Not found \\(the backfill link is wrong, expired or already used: make a new one with bab_command_center action=backfill_link\\)" }
    },
    {
      "name": "list shows the synced initiative next to the live one",
      "call": { "action": "list" },
      "expect": {
        "answer": { "initiatives": [{ "id": "billing-export", "seq": 5 }, { "id": "payments-retry", "seq": 1, "openQuestions": 1 }] },
        "answerChecks": [["initiatives", "len", 2]],
        "state": { "billing-export": [["seq", "eq", 5], ["title", "eq", "Billing export"]] }
      }
    },
    {
      "name": "a live session takes the synced initiative over with a publish",
      "call": {
        "action": "publish",
        "id": "payments-retry",
        "record": {
          "v": 1,
          "title": "Payments retry",
          "area": "Finance tools",
          "key": "KEY-2",
          "tasks": [
            { "id": "find-failures", "text": "Find the failed payments", "status": "done" },
            { "id": "retry-job", "text": "Write the retry job", "status": "done" },
            { "id": "alerting", "text": "Add alerting", "status": "in_progress" }
          ],
          "source": { "machine": "laptop", "session": "session-a" },
          "worked": "Wrote the retry job"
        }
      },
      "expect": { "answer": { "seq": 2 }, "state": { "payments-retry": [["seq", "eq", 2], ["tasks.1.status", "eq", "done"], ["questions.0.clearedAt", "set"]] } }
    },
    {
      "name": "a second backfill_link for a sync from another machine",
      "as": "second",
      "call": { "action": "backfill_link" },
      "expect": { "answerChecks": [["url", "match", "^{{origin}}/api/command-center/backfill/[0-9a-f]{64}$"]], "save": { "link2": "url" } }
    },
    {
      "name": "the same id in a second upload is skipped and the live record is unchanged",
      "http": {
        "url": "{{saved:link2}}",
        "body": {
          "v": 1,
          "current": [
            {
              "id": "payments-retry",
              "title": "Payments retry (older draft)",
              "state": "active",
              "tasks": [{ "id": "find-failures", "text": "Find the failed payments", "status": "in_progress" }],
              "questions": [{ "id": "retry-window", "text": "How long should retries go on?", "options": ["24 hours", "7 days"] }]
            }
          ]
        }
      },
      "expect": {
        "status": 200,
        "answer": { "syncCreated": 0, "syncSkipped": 1 },
        "answerChecks": [["syncRefused", "len", 0]],
        "state": {
          "payments-retry": [
            ["seq", "eq", 2],
            ["title", "eq", "Payments retry"],
            ["tasks", "len", 3],
            ["tasks.1.status", "eq", "done"],
            ["tasks.2.status", "eq", "in_progress"],
            ["questions.0.clearedAt", "set"],
            ["source.session", "eq", "session-a"]
          ],
          "billing-export": [["seq", "eq", 5]]
        }
      }
    },
    {
      "name": "remove the synced initiative again",
      "call": { "action": "remove", "id": "payments-retry" },
      "expect": { "answer": { "removed": true } }
    },
    { "name": "the person switches it off", "switch": "off" },
    {
      "name": "publish while off: the 403 sentence, nothing stored",
      "call": { "action": "publish", "id": "billing-export", "record": { "v": 1, "title": "Billing export after off", "state": "done", "worked": "Finished" } },
      "expect": { "error": "^Command Center is off for [^.]+\\. Ask them to open {{origin}}/command-center and switch it on, then publish again\\. Nothing was stored\\.$" }
    },
    {
      "name": "list while off is the same 403",
      "call": { "action": "list" },
      "expect": { "error": "^Command Center is off for [^.]+\\." }
    },
    { "name": "the person switches it on again", "switch": "on" },
    {
      "name": "the records came back unchanged by the refused publish",
      "call": { "action": "list" },
      "expect": {
        "answer": { "initiatives": [{ "id": "billing-export", "seq": 5 }] },
        "state": { "billing-export": [["title", "eq", "Billing export"], ["state", "eq", "active"]] }
      }
    }
  ]
}
