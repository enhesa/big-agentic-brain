{
  "name": "bab",
  "version": "2.15.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/enhesa/big-agentic-brain.git"
  },
  "homepage": "https://github.com/enhesa/big-agentic-brain#readme",
  "bugs": {
    "url": "https://github.com/enhesa/big-agentic-brain/issues"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 4310",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "vitest run -c vitest.e2e.config.mts",
    "test:changed": "node scripts/test-changed.mjs",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run docs:config:check && pnpm run typecheck && pnpm run coverage && pnpm run test:e2e && pnpm run check:vendor",
    "check:vendor": "bash scripts/check-vendor-names.sh",
    "docs:config": "node scripts/docs-config.mjs",
    "docs:config:check": "node scripts/docs-config.mjs --check",
    "eval": "node evals/run.mjs",
    "eval:smoke": "node evals/run.mjs --mode smoke",
    "eval:full": "node evals/run.mjs --mode full",
    "eval:validate": "node evals/run.mjs --validate",
    "eval:retrieval": "node evals/retrieval.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "5.9.2",
    "vitest": "5.0.5"
  }
}
