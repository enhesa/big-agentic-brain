# Shell scripts must stay LF: a CRLF shebang breaks them in Git Bash and on Linux.
*.sh text eol=lf
# Served instruction files: CRLF breaks the skill.md frontmatter parser.
content/instructions/* text eol=lf
# Generated by pnpm docs:config; the check compares bytes.
docs/configuration.md text eol=lf
scripts/vendor-allowlist.txt text eol=lf
scripts/public-allowlist.txt text eol=lf
evals/fixtures/distractors-synthetic.json linguist-generated
evals/fixtures/distractors-templated.json linguist-generated
# distractors-*.json are frozen artifacts (see evals/fixtures/generators/)
